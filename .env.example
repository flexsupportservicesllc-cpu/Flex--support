# ===== Mandi server secrets (set these in Vercel → Project → Settings → Environment Variables) =====
# NEVER commit real keys. NEVER put these in index.html.

# Your Stripe SECRET key (test: sk_test_... / live: sk_live_...)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe webhook signing secret (from Stripe Dashboard → Developers → Webhooks)
# Only needed if you enable /api/webhook for auto-recording payments.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
